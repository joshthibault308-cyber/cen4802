import com.sun.net.httpserver.*;
import javax.swing.*;
import java.io.IOException;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.InetSocketAddress;
import java.net.URL;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.Scanner;
import java.time.LocalTime;


public class Main {

    public static void main(String[] args) throws IOException {

        HttpServer server = HttpServer.create(new InetSocketAddress(8000), 0);
        server.createContext("/", new Handler());
        server.start();

    }

    static String WeatherAPI() {

        try{

            URL url = new URL("https://api.weather.gov/gridpoints/MLB/29,81/forecast/hourly#properties#periods");
            HttpURLConnection connection = (HttpURLConnection) url.openConnection();
            connection.setRequestMethod("GET");
            connection.connect();

            int responseCode = connection.getResponseCode();

            if (responseCode != 200) {

                throw new RuntimeException(String.valueOf(responseCode));

            } else {

                StringBuilder string = new StringBuilder();
                Scanner scanner = new Scanner(url.openStream());

                while (scanner.hasNext()) {

                    string.append(scanner.nextLine());

                }

                scanner.close();
                return(String.valueOf(string));

            }

        } catch (Exception e) {

            throw new RuntimeException(e);

        }

    }

    static String getHourlyTemp() {

        String date = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH"));
        String dateTime = "startTime\": \"" + date;

        String text = WeatherAPI();

        int startIndex = text.indexOf(dateTime);
        text = text.substring(startIndex);

        startIndex = text.indexOf("temperature") + 14;
        text = text.substring(startIndex, startIndex + 3);
        text = text.replaceAll("\\D", "");

        return "Hourly Temperature: " + text;

    }

    static class Handler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) {

            String method = exchange.getRequestMethod();
            String response = "<html> <body style=\"background-color:#B0E0E6;\">
            <img src=\"https://images.unsplash.com/photo-1601134467661-3d775b999c8b?q=80&w=1375&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\"
            width=\"800\" height=\"500\" style=\"display : block; margin-bottom: 100-pk;\">"
                    + getHourlyTemp() + " " +
                    " <form action=\"/\" method=\"POST\">" +
                    " <button type=\"submit\">Refresh</button> </form> </body> </html>";

                try {

                    exchange.sendResponseHeaders(200,response.length());
                    OutputStream os = exchange.getResponseBody();
                    os.write(response.getBytes());
                    os.close();

                } catch (IOException e) {

                    System.out.print(e.getMessage());

                }
        }
    }

}
